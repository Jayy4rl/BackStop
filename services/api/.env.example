# Backstop API and worker configuration. Development defaults apply when a value is omitted
# (NODE_ENV != production); production refuses to start without the secrets marked REQUIRED.

NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
DATABASE_URL=postgres://postgres@127.0.0.1:5432/backstop
REDIS_URL=redis://127.0.0.1:6379
TENANT_ID=1

# Keys (REQUIRED in production; 32-byte hex). In production the data key is unwrapped from a managed KMS.
DATA_KEY_HEX=
LOOKUP_KEY_HEX=
DOCUMENT_SIGNING_KEY_HEX=

# Passkeys: relying party and allowed origins (web origin + native app origins, e.g.
# android:apk-key-hash:<base64url-sha256-of-signing-cert>).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Backstop
WEBAUTHN_ORIGINS=http://localhost:5173

# Vendor adapters. "sandbox" implementations are deterministic stand-ins until vendors are chosen.
SMS_ADAPTER=sandbox            # termii
EMAIL_ADAPTER=sandbox          # postmark
PUSH_ADAPTER=sandbox           # expo
IDENTITY_ADAPTER=sandbox       # vendor to be chosen (C1-2)
CAC_ADAPTER=sandbox
SANCTIONS_ADAPTER=sandbox      # ofac (address list); person screening needs a commercial vendor
BANK_ENQUIRY_ADAPTER=sandbox   # licensed Nigerian NIP name-enquiry provider to be chosen (L4-3)
CAPTCHA_ADAPTER=sandbox        # turnstile in production
STORAGE_ADAPTER=local
FX_ADAPTER=sandbox             # http (FX_URL returning {rate, source, asOf})
ARBITER_ADAPTER=local          # safe in production (2-of-3 hardware-key signers)
SSO_ADAPTER=sandbox            # oidc in production
TERMII_API_KEY=
TERMII_SENDER_ID=Backstop
POSTMARK_TOKEN=
EMAIL_FROM=no-reply@backstop.ng
EXPO_ACCESS_TOKEN=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
FX_URL=
SANCTIONS_LIST_URL=https://www.treasury.gov/ofac/downloads/sdn.xml
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=
STORAGE_DIR=./.data/files

# Staff seeded at start-up: "email|Name|role,role;..." (roles: dispute_reviewer, risk_analyst, arbiter_signer, support, admin)
SEED_STAFF=

# Sandbox demo accounts: the web "Launch App" button creates one without sign-up. On by default
# outside production; the API refuses to start in production with DEMO_ACCOUNTS=true.
DEMO_ACCOUNTS=true

# P2P (L4) stays off until legal gate G2 is cleared.
P2P_ENABLED=false

# Chains: two node providers per chain, comma separated (failover). Omit a chain to disable it.
TRON_RPC_URLS=https://api.trongrid.io,https://api.shasta.trongrid.io
TRON_API_KEY=
TRON_USDT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_FACTORY=
TRON_FINALITY=solidified
TRON_START_BLOCK=0
TRON_KEEPER_KEY=
TRON_TREASURY=
TRON_ARBITER_ACCOUNT=

ARC_RPC_URLS=
ARC_CHAIN_ID=
ARC_USDC=0x3600000000000000000000000000000000000000
ARC_FACTORY=
ARC_FINALITY=latest
ARC_START_BLOCK=0
ARC_KEEPER_KEY=
ARC_TREASURY=
ARC_ARBITER_SAFE=

BASE_RPC_URLS=
BASE_CHAIN_ID=8453
BASE_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_FACTORY=
BASE_FINALITY=finalized
BASE_START_BLOCK=0
BASE_KEEPER_KEY=
BASE_TREASURY=
BASE_ARBITER_SAFE=
BASE_CCTP_TOKEN_MESSENGER=

ETH_RPC_URLS=
ETH_CHAIN_ID=1
ETH_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
ETH_USDT=0xdAC17F958D2ee523a2206206994597C13D831ec7
ETH_FINALITY=finalized

# Public RPC endpoints handed to the embedded wallet for signing (never keyed provider URLs).
PUBLIC_BASE_RPC_URL=
PUBLIC_ARC_RPC_URL=
PUBLIC_TRON_RPC_URL=
PUBLIC_ETHEREUM_RPC_URL=

# Local arbiter executor key (development only; production uses the Safe / TRON multisig).
ARBITER_EXECUTOR_KEY=
